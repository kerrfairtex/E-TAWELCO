# Copy this file to .env.local or set these variables in your deployment environment.
# Never commit real secrets.

# Supabase / app runtime
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# PayMongo (server-side only)
PAYMONGO_SECRET_KEY="replace-with-live-secret-key"
PAYMONGO_PUBLIC_KEY="replace-with-live-public-key"
PAYMONGO_WEBHOOK_SECRET="replace-with-live-webhook-secret"

# Demo fee / feature toggle for simulated flows
DEMO_PAYMENTS="false"
